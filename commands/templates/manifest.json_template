{
    "name": {{json .WorkerName}},
    "description": {{json (printf "Run a script on %s" .Action)}},
{{- if .HasRepoFilterCriteria }}
    "filterCriteria": {
        "artifactFilterCriteria": {
            "repoKeys": ["example-repo-local"]
        }
    },
{{- end }}
{{- if .HasSchedule }}
    "filterCriteria": {
        "schedule": {
            "cron": "0 * * * *",
            "timezone": "UTC"
        }
    },
{{- end }}
    "secrets": {},
    "properties": {},
    "sourceCodePath": "./worker.ts",
    "action": {{json .Action}},
    "enabled": false,
    "debug": false,
    "projectKey": {{json .ProjectKey}},
    "application": {{json .Application}}
}